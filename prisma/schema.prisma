generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  /// En Vercel: URL con pooling (Neon/Vercel Postgres "pooled"). Las funciones serverless abren muchas conexiones.
  url       = env("DATABASE_URL")
  /// Conexión directa (sin pooler), la usa `prisma migrate`.
  directUrl = env("DIRECT_URL")
}

/// El orden importa: se usa para ordenar la pila (URGENTE primero con orderBy desc).
enum Priority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum Status {
  NUEVO
  EN_PROGRESO
  EN_ESPERA
  RESUELTO
  CERRADO
}

enum AuthorType {
  STAFF
  REQUESTER
  SYSTEM
}

enum FieldType {
  TEXT
  TEXTAREA
  SELECT
  DATE
  NUMBER
}

model Organization {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  /// Texto introductorio del formulario
  intro          String        @default("")
  /// Nota que aparece al final del formulario
  note           String        @default("")
  themeColor     String        @default("#5f7593")
  /// Permite la opción "Otro" en el tipo de solicitud
  allowOtherType Boolean       @default(true)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  areas          Area[]
  requestTypes   RequestType[]
  fields         TicketField[]
  tickets        Ticket[]
}

model Area {
  id             String       @id @default(cuid())
  name           String
  order          Int          @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
}

model RequestType {
  id             String       @id @default(cuid())
  name           String
  order          Int          @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
}

/// Campos adicionales configurables del ticket, por organización
model TicketField {
  id             String       @id @default(cuid())
  label          String
  type           FieldType    @default(TEXT)
  options        String[]
  required       Boolean      @default(false)
  order          Int          @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Ticket {
  id             String       @id @default(cuid())
  folio          Int          @unique @default(autoincrement())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requesterEmail String
  requesterName  String
  /// Se guardan como texto para conservar el historial aunque cambie el catálogo
  areaName       String
  requestType    String
  description    String
  dueDate        DateTime?    @db.Date
  priority       Priority     @default(MEDIA)
  status         Status       @default(NUEVO)
  /// El solicitante eligió "Mi problema no está en la lista" y escribió su propio tipo
  typeNotListed  Boolean      @default(false)
  /// Respuestas a campos adicionales: { [label]: valor }
  extra          Json         @default("{}")
  /// Enlace secreto para que el solicitante dé seguimiento sin cuenta: /seguimiento/<token>
  token          String       @unique @default(cuid())
  /// true cuando el último mensaje público es del solicitante (pendiente de respuesta del equipo)
  awaitingStaff  Boolean      @default(true)
  /// Cuándo pasó a Resuelto/Cerrado (null si está abierto). Para medir cumplimiento de fechas.
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  messages       Message[]
  attachments    Attachment[]

  @@index([status, priority])
  @@index([dueDate])
}

/// Hilo del ticket: respuestas del equipo, del solicitante, notas internas y eventos del sistema
model Message {
  id          String       @id @default(cuid())
  ticketId    String
  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType  AuthorType
  authorName  String
  body        String
  /// Nota interna: solo visible para el equipo
  internal    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  attachments Attachment[]

  @@index([ticketId, createdAt])
}

/// Evidencia en Vercel Blob (privado). Se sirve solo a través de /api/archivos/<id>.
model Attachment {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  messageId   String?
  message     Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  pathname    String   @unique
  name        String
  contentType String
  size        Int
  createdAt   DateTime @default(now())

  @@index([ticketId])
}
